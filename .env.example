APP_NAME=Laravel
APP_ENV=production
APP_DEBUG=false
APP_KEY=                          # Generar con: php artisan key:generate
APP_URL=https://colmindstudio.online

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error                   # Solo errores en produccion, no 'debug' ni 'info'

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=                      # Nombre de la BD en Hostinger
DB_USERNAME=                      # NUNCA usar root en produccion — crear usuario con permisos limitados
DB_PASSWORD=                      # Contraseña fuerte

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true              # Cifrar sesiones en produccion

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# CORS se configura en config/cors.php, no aqui

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
